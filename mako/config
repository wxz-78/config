# ============================================================
# INK · mako
# ============================================================

font=DejaVuSansM Nerd Font 11
width=340
height=110
margin=12
padding=14,16
border-size=1
border-radius=14
icons=1
max-icon-size=40
markup=1
actions=1
default-timeout=6000
ignore-timeout=0
layer=overlay
anchor=top-right

background-color=#0a0a0aE6
text-color=#f0f0f0
border-color=#ffffff26
progress-color=over #ffffff33

[urgency=low]
border-color=#ffffff1a
text-color=#b5b5b5

[urgency=normal]
border-color=#ffffff33
text-color=#f0f0f0

[urgency=high]
border-color=#ffffffB0
background-color=#141414F2
text-color=#ffffff
default-timeout=0

[mode=dnd]
invisible=1

[category=volume]
default-timeout=1200
group-by=category
