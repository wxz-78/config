{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "small",
        "color": {
            "1": "white",
            "2": "white"
        },
        "padding": {
            "top": 1,
            "right": 3
        }
    },

    "display": {
        "separator": " → ",
        "color": {
            "keys": "white",
            "title": "white"
        },
        "key": {
            "width": 12
        },
        "size": {
            "binaryPrefix": "si"
        }
    },

    "modules": [
        {
            "type": "title",
            "color": {
                "user": "white",
                "at": "white",
                "host": "white"
            }
        },
        "separator",
        {
            "type": "os",
            "key": "os"
        },
        {
            "type": "kernel",
            "key": "kernel"
        },
        {
            "type": "packages",
            "key": "paquetes"
        },
        {
            "type": "shell",
            "key": "shell"
        },
        {
            "type": "wm",
            "key": "wm"
        },
        {
            "type": "terminal",
            "key": "term"
        },
        {
            "type": "terminalfont",
            "key": "fuente"
        },
        "break",
        {
            "type": "cpu",
            "key": "cpu"
        },
        {
            "type": "gpu",
            "key": "gpu"
        },
        {
            "type": "memory",
            "key": "ram"
        },
        {
            "type": "disk",
            "key": "disco"
        },
        {
            "type": "uptime",
            "key": "uptime"
        },
        "break",
        {
            "type": "colors",
            "symbol": "block",
            "paddingLeft": 12
        }
    ]
}
